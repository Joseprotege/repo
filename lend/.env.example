# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Connect publishable key — required to enable real escrow payments.
# Get it from: https://dashboard.stripe.com → Developers → API keys
# Use the "Publishable key" (pk_test_… for testing, pk_live_… for production).
# The matching SECRET key is set as a Supabase Edge Function secret, NOT here.
# Leave blank to run in mock-payment mode (escrow uses direct DB updates).
VITE_STRIPE_PUBLISHABLE_KEY=
